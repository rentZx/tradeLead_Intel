# TradeLead Intel V3.0-RC1 environment template

# Streamlit
STREAMLIT_SERVER_ADDRESS=127.0.0.1
STREAMLIT_SERVER_PORT=8501

# SQLite database path used by the app
TRADELEAD_DB_PATH=data/tradelead_v3.sqlite3

# Optional outbound route for overseas public pages.
# Supports an HTTPS edge proxy endpoint or a SOCKS5 proxy.
TRADELEAD_PROXY=

# Search API providers. Fill only the providers you plan to use.
BRAVE_SEARCH_API_KEY=
SERPAPI_API_KEY=
GOOGLE_MAPS_API_KEY=
FOURSQUARE_API_KEY=
OPENCORPORATES_API_TOKEN=
PDL_API_KEY=
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# Cost guards. These limits apply to each manual search run.
TRADELEAD_MAX_PAID_QUERIES_PER_CHANNEL=3
TRADELEAD_MAX_RESULTS_PER_CHANNEL=60
TRADELEAD_PDL_RESULTS_PER_QUERY=10

# Optional fixed-service overseas API gateway for a mainland-China server.
# Deploy api/gateway.ts overseas, set provider keys there, and list only the
# services that should use the gateway.
TRADELEAD_API_GATEWAY_URL=
TRADELEAD_API_GATEWAY_TOKEN=
TRADELEAD_GATEWAY_SERVICES=brave,google_places,serpapi,foursquare,opencorporates,pdl

# Optional OpenAI key for future AI-assisted prompts.
OPENAI_API_KEY=

# Landing page inquiry receiver
INQUIRY_SERVER_HOST=127.0.0.1
INQUIRY_SERVER_PORT=8765

# Compliance screening defaults
SANCTIONS_MATCH_THRESHOLD=88
